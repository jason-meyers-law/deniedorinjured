---
/** The one restrained call-to-action (PLAN.md §7, §22). Wording is
 * provisional until Florida advertising review; phone is Bar-verified
 * (owner confirmation of the canonical office still pending). */
import { firm, href, snippets } from "../lib/site";
---

<div class="cta">
  <p>{snippets.articleCta}</p>
  <p>
    Phone: <a href={firm.phoneHref}>{firm.phone}</a> &middot;
    <a href={href("/contact/")}>Contact the firm</a>
  </p>
</div>
