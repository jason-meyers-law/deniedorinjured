---
/** The MO monogram: a thin square with the two letters overlapping,
 * drawn with the site's serif so it matches the wordmark. */
interface Props { size?: number; class?: string }
const { size = 56, class: cls } = Astro.props;
---

<svg
  class={cls}
  width={size}
  height={size}
  viewBox="0 0 64 64"
  aria-hidden="true"
>
  <rect x="2" y="2" width="60" height="60" fill="none" stroke="currentColor" stroke-width="1.5" />
  <text
    x="10"
    y="42"
    font-family="Vollkorn, Georgia, serif"
    font-size="38"
    font-weight="500"
    fill="currentColor"
  >M</text>
  <text
    x="31"
    y="52"
    font-family="Vollkorn, Georgia, serif"
    font-size="30"
    font-weight="400"
    fill="none"
    stroke="var(--accent, #b8642f)"
    stroke-width="1.6"
  >O</text>
</svg>
