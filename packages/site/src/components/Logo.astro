---
/** The firm's logo, drawn from the sprite in public/brand/logo.svg
 * (traced from the business-card artwork; see docs/editing.md
 * "Brand assets"). The ink follows `currentColor`, so the same art
 * works on the cream header and the dark footer; the brown stays the
 * brand brown. Decorative — the surrounding link carries the name. */
import { href } from "../lib/site";

interface Props {
  part: "monogram" | "wordmark";
  /** Rendered height in CSS pixels; width follows the artwork's ratio. */
  height: number;
  class?: string;
}
const { part, height, class: cls } = Astro.props;

// viewBox sizes of the sprite symbols
const ratio = { monogram: 162.3 / 182.3, wordmark: 667.3 / 99.8 }[part];
const width = Math.round(height * ratio * 10) / 10;
---

<svg class={cls} width={width} height={height} aria-hidden="true">
  <use href={`${href("/brand/logo.svg")}#${part}`} />
</svg>
