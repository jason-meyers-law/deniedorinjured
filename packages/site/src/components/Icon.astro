---
/** Inline line icons in the accent color. Hand-drawn 24x24 paths so
 * the site ships no icon font. `florida` is a simplified state outline. */
interface Props { name: string; size?: number; class?: string }
const { name, size = 40, class: cls } = Astro.props;

const paths: Record<string, string> = {
  shield: "M12 3 4.5 6v5c0 4.6 3.2 8.4 7.5 10 4.3-1.6 7.5-5.4 7.5-10V6L12 3z M9 12l2 2 4-4",
  scales: "M12 4v16 M6 20h12 M12 6l6 1 M12 6l-6 1 M6 7l-3 6a3 3 0 0 0 6 0l-3-6z M18 7l-3 6a3 3 0 0 0 6 0l-3-6z",
  people: "M12 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5z M6 8a2 2 0 1 0 0 4 2 2 0 0 0 0-4z M18 8a2 2 0 1 0 0 4 2 2 0 0 0 0-4z M8 19v-2a4 4 0 0 1 8 0v2 M2.5 18v-1.5A3 3 0 0 1 6.5 14 M21.5 18v-1.5A3 3 0 0 0 17.5 14",
  florida: "M2.5 6.5h9.2l.4 1.8h3.6l2 1.4 1.4 3.4 1.6 3.9.8 3-1.5 1.5-2-.6-1.2-2.4-2-3-2.4-2.6-2.6-1.9-2.1-.8-.9-1.7h-2.4l-.4 1.6-2.4.4-1.1-1.6-2.1-1.4z",
  check: "M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18z M8.5 12.2l2.3 2.3 4.7-4.8",
  phone: "M5 4h3.5l1.5 4-2 1.5a11 11 0 0 0 6.5 6.5l1.5-2 4 1.5V19a2 2 0 0 1-2 2A15 15 0 0 1 3 6a2 2 0 0 1 2-2z",
  mail: "M3 6h18v12H3z M3 7l9 6 9-6",
  globe: "M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18z M3 12h18 M12 3c-3 3-3 15 0 18 M12 3c3 3 3 15 0 18",
  pin: "M12 21s-6-5.5-6-11a6 6 0 0 1 12 0c0 5.5-6 11-6 11z M12 7.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5z",
  arrow: "M4 12h16 M14 6l6 6-6 6",
  user: "M12 4a4 4 0 1 0 0 8 4 4 0 0 0 0-8z M4 21a8 8 0 0 1 16 0",
  chat: "M4 5h16v11H9l-5 4z",
  clock: "M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18z M12 7v5l3.5 2",
};
---

<svg
  class={cls}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.4"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <path d={paths[name]} />
</svg>
