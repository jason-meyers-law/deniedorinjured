  },
};
const fill = filled[name];
---

{fill ? (
  <svg
    class={cls}
    width={size}
    height={size}
    viewBox={fill.viewBox}
    fill="currentColor"
    stroke="currentColor"
    stroke-width={fill.stroke}
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d={fill.d} />
  </svg>
) : (
  <svg
    class={cls}
    width={size}
    height={size}
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.4"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d={paths[name]} />
  </svg>
)}
