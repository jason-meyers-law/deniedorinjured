---
/** Renders one answer page from the collection. */
import { getCollection, render } from "astro:content";
import Article from "../../layouts/Article.astro";
import Markdown from "../../components/Markdown.astro";

export async function getStaticPaths() {
  // Draft pages are not built at all — see personal-injury/[...slug].astro
  // for why noindex alone is insufficient.
  const entries = (await getCollection("answers")).filter((e) => !e.data.draft);
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const related = entry.data.related.map((path) => ({
  label: path.split("/").filter(Boolean).pop()!.replace(/-/g, " "),
  path,
}));
---

<Article
  title={entry.data.title}
  description={entry.data.description}
  draft={entry.data.draft}
  publishDate={entry.data.publishDate}
  legalReviewDate={entry.data.legalReviewDate}
  related={related}
  crumbs={[
    { label: "Home", path: "/" },
    { label: "Florida Injury Answers", path: "/florida-injury-answers/" },
    { label: entry.data.question, path: `/florida-injury-answers/${entry.id}/` },
  ]}
>
  <div class="direct-answer"><Markdown text={entry.data.directAnswer} /></div>
  <Content />
</Article>
