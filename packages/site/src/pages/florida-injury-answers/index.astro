---
/** Answer-library hub: the informational / AI-retrieval layer. Intro
 * from content/pages, list from the answers collection. */
import Page from "../../layouts/Page.astro";
import { href } from "../../lib/site";
import { pageContent } from "../../lib/pages";
import { getCollection } from "astro:content";

const { data: page, Content } = await pageContent("florida-injury-answers");
const answers = (await getCollection("answers")).filter((a) => !a.data.draft);
---

<Page page={page} Content={Content}>
  <ul class="card-grid">
    {answers.map((a) => (
      <li class="card">
        <h3><a href={href(`/florida-injury-answers/${a.id}/`)}>{a.data.question}</a></h3>
        <p>{a.data.description}</p>
      </li>
    ))}
  </ul>
</Page>
