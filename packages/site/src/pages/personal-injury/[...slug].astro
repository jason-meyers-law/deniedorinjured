---
/** Renders one practice-area entry from the collection. */
import { getCollection, render } from "astro:content";
import Article from "../../layouts/Article.astro";

export async function getStaticPaths() {
  // Draft pages are not built at all — noindex alone does not stop a
  // direct visit or an in-site link, so unreviewed legal content must
  // not exist as a live URL. Remove this filter once a page's draft
  // flag is cleared by attorney review.
  const entries = (await getCollection("practiceAreas")).filter(
    (e) => !e.data.draft,
  );
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const related = entry.data.related.map((path) => ({
  label: path.split("/").filter(Boolean).pop()!.replace(/-/g, " "),
  path,
}));
---

<Article
  title={entry.data.title}
  description={entry.data.description}
  draft={entry.data.draft}
  publishDate={entry.data.publishDate}
  legalReviewDate={entry.data.legalReviewDate}
  related={related}
  image={entry.data.image}
  imageAlt={entry.data.imageAlt}
  crumbs={[
    { label: "Home", path: "/" },
    { label: "Personal Injury", path: "/personal-injury/" },
    { label: entry.data.title, path: `/personal-injury/${entry.id}/` },
  ]}
>
  <Content />
</Article>
