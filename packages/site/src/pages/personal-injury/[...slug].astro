---
/** Renders one practice-area entry from the collection. */
import { getCollection, render } from "astro:content";
import Article from "../../layouts/Article.astro";

export async function getStaticPaths() {
  const entries = await getCollection("practiceAreas");
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const related = entry.data.related.map((path) => ({
  label: path.split("/").filter(Boolean).pop()!.replace(/-/g, " "),
  path,
}));
---

<Article
  title={entry.data.title}
  description={entry.data.description}
  draft={entry.data.draft}
  publishDate={entry.data.publishDate}
  legalReviewDate={entry.data.legalReviewDate}
  related={related}
>
  <Content />
</Article>
