---
/** Personal-injury hub: intro from content/pages, then the
 * practice-area collection. */
import Page from "../../layouts/Page.astro";
import { href } from "../../lib/site";
import { pageContent } from "../../lib/pages";
import { getCollection } from "astro:content";

const { data: page, Content } = await pageContent("personal-injury");
const areas = (await getCollection("practiceAreas"))
  .filter((a) => !a.data.draft)
  .sort((a, b) => a.data.order - b.data.order);
---

<Page page={page} Content={Content}>
  <ul class="card-grid">
    {areas.map((a) => (
      <li class="card">
        <h3><a href={href(`/personal-injury/${a.id}/`)}>{a.data.title}</a></h3>
        <p>{a.data.description}</p>
      </li>
    ))}
  </ul>
</Page>
