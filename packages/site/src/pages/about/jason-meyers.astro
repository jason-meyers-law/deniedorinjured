---
/** Attorneys page. Bios are the firm's own published content, adapted
 * from jasonmeyerslaw.com (retrieved 2026-09-02) — not invented. Bar
 * facts for Jason are verified against the Florida Bar profile (No.
 * 106509). Michael Onatsko's Bar number is not published on the old
 * site, so it is intentionally omitted rather than guessed. Kept
 * `noindex` until the attorneys review this combined page; remove the
 * flag below once cleared. */
import Base from "../../layouts/Base.astro";
import JsonLd from "../../components/JsonLd.astro";
import { firm, href, barProfileUrl } from "../../lib/site";

const aboutUrl = new URL(href("/about/jason-meyers/"), Astro.site).toString();

/** Jason — fields verified against the Florida Bar member profile. */
const jasonLd = {
  "@type": "Person",
  name: firm.attorney,
  jobTitle: "Attorney",
  url: aboutUrl,
  worksFor: { "@type": "LegalService", name: firm.entity },
  alumniOf: [
    { "@type": "CollegeOrUniversity", name: "Florida State University" },
    { "@type": "CollegeOrUniversity", name: "Stetson University College of Law" },
  ],
  telephone: firm.phone,
  address: {
    "@type": "PostalAddress",
    addressLocality: firm.postal.city,
    addressRegion: firm.postal.region,
    addressCountry: "US",
  },
  image: new URL(href("/images/jason-meyers.png"), Astro.site).toString(),
  sameAs: [barProfileUrl],
};

/** Michael — from his published bio only (no Bar number available). */
const michaelLd = {
  "@type": "Person",
  name: "Michael Onatsko",
  jobTitle: "Attorney",
  url: aboutUrl,
  worksFor: { "@type": "LegalService", name: firm.entity },
  alumniOf: [
    { "@type": "CollegeOrUniversity", name: "University of Central Florida" },
    { "@type": "CollegeOrUniversity", name: "Nova Southeastern University" },
  ],
};

const jasonCredentials: [string, string][] = [
  ["Florida Bar admission", "September 2013 (Bar No. 106509)"],
  ["Standing", "Member in Good Standing, eligible to practice"],
  ["Law school", "Stetson University College of Law, J.D. 2013"],
  ["Undergraduate", "Florida State University (Philosophy and Religion)"],
  ["Location", "Brevard County, Florida (18th Judicial Circuit)"],
];
const michaelCredentials: [string, string][] = [
  ["Law school", "Nova Southeastern University (J.D.)"],
  ["Undergraduate", "University of Central Florida (Legal Studies)"],
];
---

<Base
  title="Attorneys"
  description="The attorneys of Jason Meyers Law, PLLC — Jason O. Meyers and Michael Onatsko, serving Brevard County, Florida."
  noindex={true}
>
  <h1>Attorneys</h1>

  <h2>{firm.attorney}</h2>
  <div class="staff-details">
    <img
      class="staff-photo"
      src={href("/images/jason-meyers.png")}
      alt="Portrait of Jason O. Meyers"
      width="146"
      height="204"
    />
    <p>
      {firm.attorney} studied Philosophy and Religion at Florida State
      University, then spent three years as a discrimination investigator at
      the Florida Commission on Human Relations before attending law school at
      Stetson University near St. Petersburg. His legal background is in civil
      litigation — personal injury, insurance disputes, property damage, and
      breach-of-contract claims — primarily representing large corporations.
      In March 2024 he established his own practice to serve individuals and
      small business owners. He has tried multiple cases to verdict and brings
      that courtroom experience to how he advises clients.
    </p>
  </div>

  <ul>
    {jasonCredentials.map(([label, value]) => (
      <li>{label}: {value}</li>
    ))}
  </ul>

  <h3>Why representing the other side matters to an injured client</h3>
  <p>
    Having represented large corporations and insurers in personal-injury and
    coverage disputes, {firm.attorney} knows how the other side investigates,
    evaluates, and defends claims — and brings that perspective to the injured
    people he now represents.
  </p>

  <h2>Michael Onatsko</h2>
  <div class="staff-details">
    <p>
      Michael Onatsko is a first-generation American whose parents immigrated
      to the United States seeking religious freedom. He earned his bachelor's
      degree in Legal Studies from the University of Central Florida and his
      J.D. from Nova Southeastern University. He began his career in civil
      litigation defense at two large insurance-defense firms, representing
      clients ranging from individuals in motor-vehicle accidents to major
      insurance carriers, trucking companies, and Fortune 500 corporations. He
      now focuses on civil litigation, representing individuals and businesses
      across Florida.
    </p>
  </div>

  <ul>
    {michaelCredentials.map(([label, value]) => (
      <li>{label}: {value}</li>
    ))}
  </ul>

  <h2>Verify</h2>
  <p>
    Bar admission, standing, and discipline history are public record:
    <a href={barProfileUrl} rel="noopener">
      Florida Bar member profile, Bar No. {firm.barNumber}</a>.
  </p>

  <JsonLd data={jasonLd} />
  <JsonLd data={michaelLd} />
</Base>
