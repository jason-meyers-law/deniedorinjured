---
/** The About page used to live here (/about/jason-meyers/). GitHub
 * Pages cannot issue a 301, so this stub forwards old links to
 * /about/ and asks search engines not to index the stub itself. */
import { href } from "../../lib/site";
const target = new URL(href("/about/"), Astro.site).toString();
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={target} />
    <meta name="robots" content="noindex" />
    <title>Redirecting…</title>
  </head>
  <body>
    <p>This page has moved to <a href={target}>{target}</a>.</p>
  </body>
</html>
