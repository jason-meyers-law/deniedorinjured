---
/** Attorney biography skeleton. Every credential slot renders as
 * visibly unconfirmed until DECISIONS.md §9 supplies verified facts —
 * publishing an unverified credential is prohibited (PLAN.md §35). */
import Base from "../../layouts/Base.astro";
import JsonLd from "../../components/JsonLd.astro";
import { firm, href, barProfileUrl } from "../../lib/site";

/** Every field below is Bar-verified and visible on this page. */
const personLd = {
  "@type": "Person",
  name: firm.attorney,
  jobTitle: "Attorney",
  url: new URL(href("/about/jason-meyers/"), Astro.site).toString(),
  worksFor: { "@type": "LegalService", name: firm.entity },
  alumniOf: {
    "@type": "CollegeOrUniversity",
    name: "Stetson University College of Law",
  },
  telephone: firm.phone,
  address: {
    "@type": "PostalAddress",
    addressLocality: firm.postal.city,
    addressRegion: firm.postal.region,
    addressCountry: "US",
  },
  sameAs: [barProfileUrl],
};

/** The first block is verified against the Florida Bar member profile
 * for Bar #106509 (retrieved 2026-08-30); the rest awaits DECISIONS.md
 * §9 facts from the attorney. */
const verified: [string, string][] = [
  ["Florida Bar admission", "September 2013 (Bar No. 106509)"],
  ["Standing", "Member in Good Standing, eligible to practice"],
  ["Law school", "Stetson University College of Law, J.D. 2013"],
  ["Location", "Brevard County, Florida (18th Judicial Circuit)"],
];
const pending: [string, string][] = [
  ["Federal court admissions", "[CONFIRM — DECISIONS.md §9]"],
  ["Insurance-defense experience", "[CONFIRM]"],
  ["Trial experience", "[CONFIRM]"],
  ["Professional memberships", "[CONFIRM]"],
];
---

<Base
  title="Jason O. Meyers — Florida Attorney"
  description="Biography of Jason O. Meyers, Florida attorney at Jason Meyers Law, PLLC."
>
  <h1>{firm.attorney}</h1>
  <p class="draft-notice">
    Draft biography — bar facts below are verified against the Florida
    Bar member profile; the highlighted items are placeholders awaiting
    the attorney, and the page needs his review before it can be indexed.
  </p>
  <p>
    {firm.attorney} is a Florida attorney practicing in Brevard County.
    Before representing injured people, he spent years on the insurance
    side of injury litigation — experience that shapes how he evaluates
    and works up claims for injured clients.
  </p>

  <h2>Credentials</h2>
  <ul>
    {verified.map(([label, value]) => (
      <li>{label}: {value}</li>
    ))}
    {pending.map(([label, value]) => (
      <li>{label}: <span class="unconfirmed">{value}</span></li>
    ))}
  </ul>

  <h2>Why former insurance-defense experience matters to an injured client</h2>
  <p>
    Insurers do not evaluate claims the way injured people expect. An
    attorney who has worked inside that process knows what adjusters
    investigate, what defense lawyers look for in medical records and
    depositions, and what actually moves a claim's evaluation. The
    specifics of this section will be written from {firm.attorney}'s
    verified experience — not generic speculation.
  </p>

  <h2>Verify</h2>
  <p>
    Bar admission, standing, and discipline history are public record:
    <a href={barProfileUrl} rel="noopener">
      Florida Bar member profile, Bar No. {firm.barNumber}</a>.
  </p>
  <JsonLd data={personLd} />
</Base>
