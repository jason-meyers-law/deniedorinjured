---
/** Homepage: the two-path gateway (PLAN.md §40 concept, provisional
 * wording). PI dominates per Phase 1; the insurance-denied path is
 * present but secondary and links to a reserved hub. Words come from
 * content/pages/home.md; structure and JSON-LD stay here. */
import Page from "../layouts/Page.astro";
import JsonLd from "../components/JsonLd.astro";
import Markdown from "../components/Markdown.astro";
import { firm, href } from "../lib/site";
import { pageContent } from "../lib/pages";
import { getCollection } from "astro:content";

const { data: page, Content } = await pageContent("home");

const areas = (await getCollection("practiceAreas"))
  .filter((a) => !a.data.draft)
  .sort((a, b) => a.data.order - b.data.order);

const homeUrl = new URL(href("/"), Astro.site).toString();

/** Entity facts here are Bar-verified and visible on the site (footer
 * NAP, bio). Anything unconfirmed (hours, logo, geo) stays out until
 * DECISIONS.md resolves it — PLAN.md §10. */
const legalServiceLd = {
  "@type": "LegalService",
  name: firm.entity,
  alternateName: firm.brand,
  url: homeUrl,
  telephone: firm.phone,
  address: {
    "@type": "PostalAddress",
    streetAddress: firm.postal.street,
    addressLocality: firm.postal.city,
    addressRegion: firm.postal.region,
    postalCode: firm.postal.zip,
    addressCountry: "US",
  },
  areaServed: "Brevard County, Florida",
  founder: {
    "@type": "Person",
    name: firm.attorney,
    url: new URL(href("/about/jason-meyers/"), Astro.site).toString(),
  },
};

const webSiteLd = {
  "@type": "WebSite",
  name: firm.brand,
  url: homeUrl,
};
---

<Page page={page} Content={Content} hero>
  {page.gateway && (
    <div class="gateway">
      {page.gateway.map((g) => (
        <a class="card" href={href(g.link)}>
          <h2>{g.heading}</h2>
          <p>{g.text}</p>
        </a>
      ))}
    </div>
  )}

  {areas.length > 0 && (
    <>
      <h2>{page.casesHeading}</h2>
      <ul class="card-grid">
        {areas.map((a) => (
          <li class="card">
            <h3><a href={href(`/personal-injury/${a.id}/`)}>{a.data.title}</a></h3>
            <p>{a.data.description}</p>
          </li>
        ))}
      </ul>
    </>
  )}

  {page.answers && (
    <>
      <h2>{page.answers.heading}</h2>
      <Markdown text={page.answers.text} />
    </>
  )}
  <JsonLd data={legalServiceLd} />
  <JsonLd data={webSiteLd} />
</Page>
