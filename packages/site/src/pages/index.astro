---
/** Homepage, laid out to the firm's 2026-09 mockup: hero, practice
 * cards, four values, about band, consultation band with photo, the
 * contact form. Words and images come from content/pages/home.md;
 * structure and JSON-LD stay here. */
import Page from "../layouts/Page.astro";
import Button from "../components/Button.astro";
import ContactForm from "../components/ContactForm.astro";
import Icon from "../components/Icon.astro";
import JsonLd from "../components/JsonLd.astro";
import Photo from "../components/Photo.astro";
import PracticeCards from "../components/PracticeCards.astro";
import { firm, href, mapDirectionsUrl } from "../lib/site";
import { pageContent } from "../lib/pages";

const { data: page, Content } = await pageContent("home");
const { hero, practice, values, about, cta } = page;

const homeUrl = new URL(href("/"), Astro.site).toString();

/** Entity facts here are Bar-verified and visible on the site (header
 * logo, footer NAP + map link + hours, bio). Anything unconfirmed
 * (price range, geo coordinates) stays out. */
const legalServiceLd = {
  "@type": "LegalService",
  "@id": `${homeUrl}#firm`,
  name: firm.brand,
  legalName: firm.entity,
  alternateName: "Denied or Injured",
  url: homeUrl,
  logo: new URL(href("/brand/lockup.svg"), Astro.site).toString(),
  image: new URL(href("/og-image.png"), Astro.site).toString(),
  telephone: firm.phoneHref.replace("tel:", ""),
  email: firm.email,
  address: {
    "@type": "PostalAddress",
    streetAddress: firm.postal.street,
    addressLocality: firm.postal.city,
    addressRegion: firm.postal.region,
    postalCode: firm.postal.zip,
    addressCountry: "US",
  },
  hasMap: mapDirectionsUrl,
  openingHoursSpecification: {
    "@type": "OpeningHoursSpecification",
    dayOfWeek: firm.hoursSpec.days,
    opens: firm.hoursSpec.opens,
    closes: firm.hoursSpec.closes,
  },
  areaServed: { "@type": "State", name: "Florida" },
  founder: {
    "@type": "Person",
    name: firm.attorney,
    url: new URL(href("/about/"), Astro.site).toString(),
  },
};

const webSiteLd = {
  "@type": "WebSite",
  name: firm.brand,
  url: homeUrl,
};
---

<Page page={page} Content={Content} plain>
  {hero && (
    <section class="hero">
      <Photo class="hero-img" src={hero.image} alt={hero.imageAlt} width={1600} height={900} sizes="100vw" loading="eager" fetchpriority="high" />
      <div class="wrap hero-row">
        <div class="hero-copy">
          {hero.eyebrow && <p class="eyebrow">{hero.eyebrow}</p>}
          <h1>{page.title}</h1>
          <div class="hero-text"><Content /></div>
          <p class="hero-actions">
            <Button href={hero.primary.link}>{hero.primary.label}</Button>
            {hero.secondary && <Button href={hero.secondary.link} variant="outline">{hero.secondary.label}</Button>}
          </p>
        </div>
        {hero.aside && <p class="hero-aside">{hero.aside}</p>}
      </div>
    </section>
  )}

  {practice && (
    <section class="practice-section">
      <div class="wrap">
        <h2 class="section-title">{practice.heading}</h2>
        {practice.subheading && <p class="section-sub">{practice.subheading}</p>}
        <PracticeCards />
      </div>
    </section>
  )}

  {values && (
    <section class="values-section">
      <ul class="wrap values">
        {values.map((v) => (
          <li>
            <Icon name={v.icon} size={44} />
            <span>{v.label}</span>
          </li>
        ))}
      </ul>
    </section>
  )}

  {about && (
    <section class="about-band">
      <div class="about-copy">
        {about.eyebrow && <p class="eyebrow">{about.eyebrow}</p>}
        <h2>{about.heading}</h2>
        <p>{about.text}</p>
        {about.points.length > 0 && (
          <ul class="about-points">
            {about.points.map((p) => (
              <li><Icon name="check" size={30} />{p}</li>
            ))}
          </ul>
        )}
        <p><Button href={about.button.link}>{about.button.label}</Button></p>
      </div>
      <Photo class="about-img" src={about.image} alt={about.imageAlt} width={1200} height={900} sizes="(min-width: 900px) 50vw, 100vw" loading="lazy" />
    </section>
  )}

  {cta && (
    <section class="cta-band">
      <Photo class="cta-img" src={cta.image} alt={cta.imageAlt} width={1600} height={700} sizes="100vw" loading="lazy" />
      <div class="wrap cta-copy">
        {cta.eyebrow && <p class="eyebrow">{cta.eyebrow}</p>}
        <h2>{cta.heading}</h2>
        {cta.text && <p>{cta.text}</p>}
        <p><Button href={cta.button.link}>{cta.button.label}</Button></p>
      </div>
    </section>
  )}

  <ContactForm />
  <JsonLd data={legalServiceLd} />
  <JsonLd data={webSiteLd} />
</Page>
