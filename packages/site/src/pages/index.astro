---
/** Homepage: the two-path gateway (PLAN.md §40 concept, provisional
 * wording). PI dominates per Phase 1; the insurance-denied path is
 * present but secondary and links to a reserved hub. */
import Base from "../layouts/Base.astro";
import JsonLd from "../components/JsonLd.astro";
import { firm, href, barProfileUrl } from "../lib/site";
import { getCollection } from "astro:content";

const areas = (await getCollection("practiceAreas")).sort(
  (a, b) => a.data.order - b.data.order,
);

const homeUrl = new URL(href("/"), Astro.site).toString();

/** Entity facts here are Bar-verified and visible on the site (footer
 * NAP, bio). Anything unconfirmed (hours, logo, geo) stays out until
 * DECISIONS.md resolves it — PLAN.md §10. */
const legalServiceLd = {
  "@type": "LegalService",
  name: firm.entity,
  alternateName: firm.brand,
  url: homeUrl,
  telephone: firm.phone,
  address: {
    "@type": "PostalAddress",
    streetAddress: firm.postal.street,
    addressLocality: firm.postal.city,
    addressRegion: firm.postal.region,
    postalCode: firm.postal.zip,
    addressCountry: "US",
  },
  areaServed: "Brevard County, Florida",
  founder: {
    "@type": "Person",
    name: firm.attorney,
    url: new URL(href("/about/jason-meyers/"), Astro.site).toString(),
  },
};

const webSiteLd = {
  "@type": "WebSite",
  name: firm.brand,
  url: homeUrl,
};
---

<Base
  title="Denied or Injured — Florida Personal Injury and Insurance Law"
  description="Florida personal-injury and insurance-coverage representation from Jason Meyers Law, PLLC in Brevard County."
  hero
>
  <h1>Denied or Injured?</h1>
  <p>
    When an injury changes your life—or an insurance company refuses to
    provide the protection you paid for—you need to understand what
    happens next.
  </p>
  <p>
    {firm.attorney} represents injured people and insureds in Florida.
    His background defending personal-injury claims provides a practical
    understanding of how insurers investigate, evaluate, defend, and
    resolve claims.
  </p>

  <div class="gateway">
    <a class="card" href={href("/personal-injury/")}>
      <h2>Were you injured?</h2>
      <p>
        Car crashes, bicycle and pedestrian collisions, unsafe premises,
        wrongful death. What the claim process looks like and what to do
        now.
      </p>
    </a>
    <a class="card" href={href("/insurance-denied/")}>
      <h2>Did your insurer deny you?</h2>
      <p>
        Denied defense, reservation of rights, coverage and indemnity
        disputes, failure to settle. Representation for Florida insureds.
      </p>
    </a>
  </div>

  <h2>Injury cases we handle</h2>
  <ul class="card-grid">
    {areas.map((a) => (
      <li class="card">
        <h3><a href={href(`/personal-injury/${a.id}/`)}>{a.data.title}</a></h3>
        <p>{a.data.description}</p>
      </li>
    ))}
  </ul>

  <h2>Florida injury answers</h2>
  <p>
    Direct answers to the questions injured people actually ask—who pays
    the medical bills, what to say to an adjuster, what a case is worth,
    what happens after suit is filed.
    <a href={href("/florida-injury-answers/")}>Browse the answer library</a>.
  </p>
  <JsonLd data={legalServiceLd} />
  <JsonLd data={webSiteLd} />
</Base>
