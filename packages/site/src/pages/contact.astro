---
/** Contact page. Static site: no form backend yet — phone/email only
 * until the intake workflow (DECISIONS.md §16) and a form processor
 * are chosen. Details render as visibly unconfirmed until then. */
import Base from "../layouts/Base.astro";
import { firm } from "../lib/site";
---

<Base
  title="Contact | Denied or Injured"
  description="Contact Jason Meyers Law, PLLC in Brevard County, Florida."
>
  <h1>Contact</h1>
  <p>
    {firm.entity} — {firm.geography}.
  </p>
  <ul>
    <li>Phone: <span class="unconfirmed">{firm.phone}</span></li>
    <li>Email: <span class="unconfirmed">{firm.email}</span></li>
    <li>Office: <span class="unconfirmed">{firm.address}</span></li>
  </ul>
  <p>
    Contacting the firm does not create an attorney–client relationship,
    and you should not send confidential or time-sensitive information
    until a representation has been established.
  </p>
</Base>
