---
/** Contact: intro, the office block with a Google Maps embed and a
 * directions link, and the form (when a processor is configured). */
import Page from "../layouts/Page.astro";
import ContactForm from "../components/ContactForm.astro";
import Icon from "../components/Icon.astro";
import { firm, mapEmbedUrl, mapDirectionsUrl } from "../lib/site";
import { pageContent } from "../lib/pages";

const { data: page, Content } = await pageContent("contact");
const office = page.office;
---

<Page page={page} Content={Content}>
  <div class="office">
    <iframe
      class="office-map"
      src={mapEmbedUrl}
      title={`Map showing ${firm.brand} at ${firm.address}`}
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
      allowfullscreen
    ></iframe>
    <div class="office-details">
      {office && <h2>{office.heading}</h2>}
      <p class="office-address">
        {firm.postal.street}<br />
        {firm.postal.city}, {firm.postal.region} {firm.postal.zip}
      </p>
      {office && (
        <p><a class="more" href={mapDirectionsUrl} rel="noopener">{office.directions} <Icon name="arrow" size={18} /></a></p>
      )}
      <ul class="office-contact">
        <li><Icon name="phone" size={18} /><a href={firm.phoneHref}>{firm.phone}</a></li>
        <li><Icon name="mail" size={18} /><a href={`mailto:${firm.email}`}>{firm.email}</a></li>
        <li><Icon name="clock" size={18} />{firm.hours}</li>
      </ul>
    </div>
  </div>
  <ContactForm slot="after" />
</Page>
