---
/** Base HTML shell in the Justice-template layout: centered display
 * header with nav (hero image on pages that ask for it), light main
 * section, dark contact band, columned footer. Staging noindex and
 * banner ride along on every page. */
import { getCollection } from "astro:content";
import { STAGING, firm, href } from "../lib/site";
import Analytics from "../components/Analytics.astro";
import BaseHead from "../components/BaseHead.astro";
import "../styles/global.css";

// Footer only links to reviewed (non-draft) practice-area pages — a
// draft page isn't built at all (see personal-injury/[...slug].astro),
// so linking to one would be a dead link.
const publishedAreas = (await getCollection("practiceAreas"))
  .filter((a) => !a.data.draft)
  .sort((a, b) => a.data.order - b.data.order);

interface Props {
  title: string;
  description: string;
  ogType?: "website" | "article";
  /** Show the header hero image (homepage). */
  hero?: boolean;
  /** Force noindex on this page even after launch (draft legal content). */
  noindex?: boolean;
}
const { title, description, ogType, hero = false, noindex = false } = Astro.props;

const nav = [
  ["Personal Injury", "/personal-injury/"],
  ["Injury Answers", "/florida-injury-answers/"],
  ["Insurance Denied", "/insurance-denied/"],
  ["About", "/about/jason-meyers/"],
  ["Contact", "/contact/"],
] as const;

const current = Astro.url.pathname;
const isActive = (path: string) => current.startsWith(href(path));
---

<html lang="en">
  <head>
    <BaseHead title={title} description={description} ogType={ogType} noindex={noindex} />
    <Analytics />
  </head>
  <body>
    {STAGING && (
      <div class="banner">
        Staging preview — draft content, pending attorney review. Not legal advice.
      </div>
    )}
    <header class="site-header">
      <p class="brand-title"><a href={href("/")}>{firm.brand}</a></p>
      <p class="brand-line">{firm.brandLine}</p>
      <nav class="site-nav">
        <ul>
          {nav.map(([label, path]) => (
            <li>
              <a href={href(path)} class={isActive(path) ? "active" : undefined}>{label}</a>
            </li>
          ))}
        </ul>
      </nav>
      {hero && (
        <img
          class="header-img"
          src={href("/images/building.jpg")}
          alt="Stone high-rise building photographed from street level"
          width="2003"
          height="1728"
        />
      )}
    </header>
    <main class="main-section">
      <div class="wrap">
        <slot />
      </div>
    </main>
    <section class="quote-section">
      <p class="wrap">
        <a href={href("/contact/")}>Contact {firm.entity}</a> to discuss an
        injury or an insurance denial.
      </p>
    </section>
    <footer class="site-footer">
      <div class="footer-columns">
        <ul class="footer-links">
          <li><h2>Injured</h2></li>
          {publishedAreas.map((a) => (
            <li><a href={href(`/personal-injury/${a.id}/`)}>{a.data.title}</a></li>
          ))}
          <li><a href={href("/florida-injury-answers/")}>Florida Injury Answers</a></li>
        </ul>
        <ul class="footer-links">
          <li><h2>Denied</h2></li>
          <li><a href={href("/insurance-denied/")}>Insurance Coverage Disputes</a></li>
        </ul>
        <ul class="footer-links">
          <li><h2>Firm</h2></li>
          <li><a href={href("/about/jason-meyers/")}>Attorneys</a></li>
          <li><a href={href("/contact/")}>Contact</a></li>
        </ul>
        <ul class="footer-links">
          <li><h2>{firm.entity}</h2></li>
          <li>{firm.address}</li>
          <li><a href={firm.phoneHref}>{firm.phone}</a></li>
          <li>{firm.geography}</li>
        </ul>
      </div>
      <div class="legal-line">
        <p>
          The information on this website is general information, not legal
          advice, and reading it does not create an attorney–client
          relationship. Contacting the firm does not by itself create an
          attorney–client relationship.
        </p>
        <p>
          <a href={href("/disclaimer/")}>Disclaimer</a>
          &bull; <a href={href("/privacy/")}>Privacy</a>
        </p>
        <p>
          &copy; {new Date().getFullYear()} {firm.entity}
          &bull; Template by <a href="https://cloudcannon.com/" rel="noopener">CloudCannon</a>
        </p>
      </div>
    </footer>
  </body>
</html>
