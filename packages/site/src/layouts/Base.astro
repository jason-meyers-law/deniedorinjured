---
/** Base HTML shell: logo + nav bar with the consultation button, the
 * page in the slot, then the dark footer (brand block, nav, contact
 * details, copyright, legal line). Staging noindex and banner
 * ride along on every page. */
import { STAGING, firm, href, mapDirectionsUrl, practiceAreas, snippets } from "../lib/site";
import Analytics from "../components/Analytics.astro";
import BaseHead from "../components/BaseHead.astro";
import Icon from "../components/Icon.astro";
import Logo from "../components/Logo.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  ogType?: "website" | "article";
  /** Force noindex on this page even after launch (draft legal content). */
  noindex?: boolean;
}
const { title, description, ogType, noindex = false } = Astro.props;

const nav = [
  ["Home", "/"],
  ["Practice Areas", "/practice-areas/"],
  ["About", "/about/"],
  ["Resources", "/florida-injury-answers/"],
  ["Contact", "/contact/"],
] as const;

const current = Astro.url.pathname;
const isActive = (path: string) =>
  path === "/" ? current === href("/") : current.startsWith(href(path));
---

<html lang="en">
  <head>
    <BaseHead title={title} description={description} ogType={ogType} noindex={noindex} />
    <Analytics />
  </head>
  <body>
    {STAGING && (
      <div class="banner">
        Staging preview — draft content, pending attorney review. Not legal advice.
      </div>
    )}
    <header class="site-header">
      <div class="wrap header-row">
        <a class="brand" href={href("/")} aria-label={`${firm.brand} — ${firm.brandLine}: home`}>
          <Logo part="monogram" height={56} class="brand-mark" />
          <Logo part="wordmark" height={40} class="brand-word" />
        </a>
        <nav class="site-nav" aria-label="Main">
          <ul>
            {nav.map(([label, path]) => (
              <li>
                <a href={href(path)} class={isActive(path) ? "active" : undefined}>{label}</a>
              </li>
            ))}
          </ul>
        </nav>
        <a class="btn btn-solid header-cta" href={href("/contact/")}>Free Consultation</a>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap footer-row">
        <div class="footer-brand">
          <a class="brand" href={href("/")} aria-label={`${firm.brand} — ${firm.brandLine}: home`}>
            <Logo part="monogram" height={48} class="brand-mark" />
            <Logo part="wordmark" height={34} class="brand-word" />
          </a>
          <p class="footer-areas">{practiceAreas.map((p) => p.heading).join("  |  ")}</p>
          <p class="footer-place">{firm.geography}</p>
        </div>
        <ul class="footer-nav">
          {nav.map(([label, path]) => (
            <li><a href={href(path)}>{label}</a></li>
          ))}
        </ul>
        <ul class="footer-contact">
          <li><Icon name="phone" size={18} /><a href={firm.phoneHref}>{firm.phone}</a></li>
          <li><Icon name="mail" size={18} /><a href={`mailto:${firm.email}`}>{firm.email}</a></li>
          <li><Icon name="globe" size={18} /><a href={href("/")}>{firm.website}</a></li>
          <li><Icon name="pin" size={18} /><a href={mapDirectionsUrl} target="_blank" rel="noopener">{firm.address}</a></li>
        </ul>
      </div>
      <div class="wrap footer-bottom">
        <p class="copyright">&copy; {new Date().getFullYear()} {firm.brand}. All rights reserved.</p>
      </div>
      <div class="wrap legal-line">
        <p>{snippets.footerNotice}</p>
        <p>
          <a href={href("/disclaimer/")}>Disclaimer</a>
          &bull; <a href={href("/privacy/")}>Privacy</a>
          &bull; <a href={href("/credits/")}>Photo credits</a>
        </p>
      </div>
    </footer>
  </body>
</html>
