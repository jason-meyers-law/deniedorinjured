---
/** Chrome for legal articles (practice areas and answer pages):
 * breadcrumbs (+BreadcrumbList JSON-LD), draft notice while
 * unreviewed, rendered body, Article JSON-LD, related links, author
 * block, restrained CTA. The body comes from the content collections. */
import Base from "./Base.astro";
import AuthorBox from "../components/AuthorBox.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import ContactCTA from "../components/ContactCTA.astro";
import JsonLd from "../components/JsonLd.astro";
import { firm, href } from "../lib/site";

interface Props {
  title: string;
  description: string;
  draft: boolean;
  publishDate?: Date;
  legalReviewDate?: Date;
  related?: { label: string; path: string }[];
  crumbs?: { label: string; path: string }[];
  /** Themed illustration (site-relative path, e.g. /images/practice/car.svg). */
  image?: string;
  imageAlt?: string;
}
const {
  title, description, draft, publishDate, legalReviewDate,
  related = [], crumbs = [], image, imageAlt,
} = Astro.props;

/** Dates appear only once real (frontmatter-set); nothing fabricated. */
const articleLd = {
  "@type": "Article",
  headline: title,
  description,
  mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).toString(),
  author: {
    "@type": "Person",
    name: firm.attorney,
    url: new URL(href("/about/jason-meyers/"), Astro.site).toString(),
  },
  publisher: { "@type": "Organization", name: firm.entity },
  ...(publishDate && { datePublished: publishDate.toISOString() }),
  ...(legalReviewDate && { dateModified: legalReviewDate.toISOString() }),
};
---

<Base title={title} description={description} ogType="article" noindex={draft}>
  <article>
    {crumbs.length > 0 && <Breadcrumbs items={crumbs} />}
    <h1>{title}</h1>
    {image && (
      <img class="page-art" src={href(image)} alt={imageAlt ?? ""} width="800" height="260" />
    )}
    {draft && (
      <p class="draft-notice">
        Draft — this page has not completed attorney legal review. Statements
        of Florida law below are placeholders until verified against primary
        sources.
      </p>
    )}
    <slot />
    {related.length > 0 && (
      <>
        <h2>Related questions</h2>
        <ul>
          {related.map((r) => (
            <li><a href={href(r.path)}>{r.label}</a></li>
          ))}
        </ul>
      </>
    )}
    <ContactCTA />
    <AuthorBox publishDate={publishDate} legalReviewDate={legalReviewDate} />
  </article>
  <JsonLd data={articleLd} />
</Base>
